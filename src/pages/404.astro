---
// A real 404 page: without it Cloudflare Pages answers unknown paths with the home page and a
// 200 status, which search engines treat as duplicate "soft 404" pages.
const title = "Page not found · MCP servers by Matt Oddie";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Space+Grotesk:wght@700&display=swap" />
  </head>
  <body>
    <main>
      <img src="/favicon.svg" alt="" width="72" height="72" />
      <h1>Page not found</h1>
      <p>That page doesn't exist. The MCP servers are all listed on the home page.</p>
      <a class="btn" href="/">Back to the servers</a>
    </main>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #07080d; color: #eceef4; font: 16px/1.6 "Inter", system-ui, sans-serif; }
      main { text-align: center; padding: 24px 16px; }
      img { border-radius: 16px; }
      h1 { font: 700 44px/1.1 "Space Grotesk", "Inter", sans-serif; letter-spacing: -0.02em; margin: 20px 0 10px; }
      p { color: #9ba1b3; margin: 0 0 26px; }
      .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 12px; color: #fff; text-decoration: none; font-weight: 600; background: linear-gradient(135deg, #ea580c, #4f46e5 40%, #0ea5e9 70%, #10b981); }
    </style>
  </body>
</html>
