---
import { servers } from "../servers";
import { facts, image, repoUrl, site } from "../lib/github";

const GITHUB = "https://github.com/mattoddie";
const title = "MCP servers by Matt Oddie";
const description =
  "Open-source Model Context Protocol servers that connect Claude and other AI assistants to Proxmox, UniFi, Crunch Accounting and Hyundai Bluelink. Read-only by default, one Docker container each.";

const cards = await Promise.all(servers.map(async (s) => ({ ...s, ...(await facts(s)) })));
const totalTools = cards.reduce((n, c) => n + c.tools, 0);
const totalPrompts = cards.reduce((n, c) => n + c.prompts, 0);

const principles = [
  {
    icon: "🛡️",
    title: "Safe by default",
    text: "Every server starts read-only. Changes, deletes and anything sensitive are separate switches, and tools that aren't allowed aren't registered at all.",
  },
  {
    icon: "🐳",
    title: "One small container",
    text: "Each server is one Docker image for amd64 and arm64, serving Streamable HTTP with a bearer token, or stdio for a single machine.",
  },
  {
    icon: "🔌",
    title: "Any MCP client",
    text: "Claude Code, Claude Desktop, VS Code, Cursor, Codex, or anything else that speaks the Model Context Protocol.",
  },
  {
    icon: "📚",
    title: "Documented and tested",
    text: "A tool reference generated from the code, a test suite run in CI, and release images with an SBOM and signed provenance.",
  },
];

const connectSnippet = `claude mcp add --transport http <name> \\
  http://<docker-host>:8080/mcp \\
  --header "Authorization: Bearer <token>"`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#07080d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="MCP servers home">
          <img src="/favicon.svg" alt="" width="30" height="30" />
          <span>mcp<span class="dim">.mattoddie.dev</span></span>
        </a>
        <nav aria-label="Main">
          <a href="#servers">Servers</a>
          <a href="#how" class="hide-sm">How they work</a>
          <a class="gh" href={GITHUB} aria-label="mattoddie on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            <span class="hide-sm">GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap">
          <p class="eyebrow"><span class="dot"></span> Open source · MIT · Model Context Protocol</p>
          <h1>
            Talk to your
            <span class="rotator" aria-live="off">
              {
                cards.map((c, i) => (
                  <span class:list={["word", { on: i === 0 }]} style={`--a:${c.colors[0]};--b:${c.colors[1]};--c:${c.colors[2]}`}>
                    {c.subject}.
                  </span>
                ))
              }
            </span>
          </h1>
          <p class="lede">
            Open-source MCP servers that connect Claude and other AI assistants to the things you run: your home lab, your network,
            your books and your car. Ask in plain English, and let the assistant make changes only when you allow it.
          </p>
          <div class="cta">
            <a class="btn primary" href="#servers">Browse the servers <span aria-hidden="true">↓</span></a>
            <a class="btn ghost" href={GITHUB}>GitHub</a>
          </div>
        </div>
      </section>

      <section class="stats wrap" aria-label="At a glance">
        <div><strong>{cards.length}</strong><span>MCP servers</span></div>
        <div><strong>{totalTools}</strong><span>tools</span></div>
        <div><strong>{totalPrompts}</strong><span>guided prompts</span></div>
        <div><strong>MIT</strong><span>licensed</span></div>
      </section>

      <section class="section wrap" id="servers">
        <div class="section-head">
          <p class="kicker">The servers</p>
          <h2>Pick what you want to talk to.</h2>
        </div>
        <div class="cards">
          {
            cards.map((c) => (
              <article class="card" style={`--a:${c.colors[0]};--b:${c.colors[1]};--c:${c.colors[2]}`}>
                <div class="card-top">
                  <img class="logo" src={c.logo} alt="" width="56" height="56" />
                  <div>
                    <h3>
                      <a href={site(c)}>{c.repo}</a>
                    </h3>
                    <p class="product">{c.product}</p>
                  </div>
                  <span class="category">{c.category}</span>
                </div>
                <p class="talk">
                  Talk to your <span class="grad">{c.subject}.</span>
                </p>
                <p class="summary">{c.summary}</p>
                <blockquote>“{c.question}”</blockquote>
                <ul class="facts">
                  <li>
                    <strong>{c.tools}</strong> tools
                  </li>
                  {c.prompts > 0 && (
                    <li>
                      <strong>{c.prompts}</strong> prompts
                    </li>
                  )}
                  {c.version && (
                    <li>
                      <a href={`${repoUrl(c)}/releases/tag/v${c.version}`}>
                        <strong>v{c.version}</strong>
                      </a>
                      {c.released && <span class="date"> · {c.released}</span>}
                    </li>
                  )}
                </ul>
                <div class="pull">
                  <code>docker pull {image(c)}</code>
                  <button class="copy" data-copy={`docker pull ${image(c)}`} aria-label={`Copy docker pull command for ${c.repo}`}>
                    Copy
                  </button>
                </div>
                <div class="links">
                  <a class="btn small primary" href={site(c)}>
                    Website <span aria-hidden="true">→</span>
                  </a>
                  <a class="btn small ghost" href={`${site(c)}/docs/getting-started/`}>
                    Get started
                  </a>
                  <a class="btn small ghost" href={`${site(c)}/docs/tools/`}>
                    Tools
                  </a>
                  <a class="btn small ghost" href={repoUrl(c)}>
                    GitHub
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section wrap" id="how">
        <div class="section-head">
          <p class="kicker">How they work</p>
          <h2>Built the same way, every time.</h2>
          <p>Learn one and you know them all: the same settings, the same safety switches and the same way to connect.</p>
        </div>
        <div class="principles">
          {
            principles.map((p) => (
              <article class="principle">
                <span class="p-icon" aria-hidden="true">{p.icon}</span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </article>
            ))
          }
        </div>
        <div class="connect">
          <div>
            <h3>Connect one to Claude Code</h3>
            <p>
              Start a server's container with its <code>compose.yaml</code>, then add it with the token you set in <code>MCP_AUTH_TOKEN</code>.
              Each server's getting-started guide has the details, and the setup for other clients.
            </p>
          </div>
          <div class="code">
            <button class="copy" data-copy={connectSnippet} aria-label="Copy command">Copy</button>
            <pre><code>{connectSnippet}</code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap foot-inner">
        <div class="foot-links">
          {cards.map((c) => <a href={site(c)}>{c.repo}</a>)}
          <a href={GITHUB}>GitHub</a>
          <a href="https://mattoddie.dev">mattoddie.dev</a>
        </div>
        <p>
          MIT © Matt Oddie. These are independent community projects. They are not affiliated with or endorsed by Proxmox Server
          Solutions GmbH, Ubiquiti Inc., Crunch Accounting or Hyundai Motor Company. Product names are trademarks of their owners.
        </p>
      </div>
    </footer>

    <script>
      for (const btn of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            btn.textContent = "Copied";
          } catch {
            btn.textContent = "Select & copy";
          }
          setTimeout(() => (btn.textContent = "Copy"), 1600);
        });
      }

      // Cycle the hero's "Talk to your …" through each server's subject.
      const words = [...document.querySelectorAll<HTMLElement>(".rotator .word")];
      if (words.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let i = 0;
        setInterval(() => {
          words[i].classList.remove("on");
          i = (i + 1) % words.length;
          words[i].classList.add("on");
        }, 2600);
      }
    </script>

    <style is:global>
      :root {
        --bg: #07080d;
        --bg-2: #0b0d14;
        --panel: rgba(255, 255, 255, 0.035);
        --panel-2: rgba(255, 255, 255, 0.065);
        --line: rgba(255, 255, 255, 0.09);
        --text: #eceef4;
        --muted: #9ba1b3;
        --green: #34d399;
        --radius: 18px;
        --display: "Space Grotesk", "Inter", ui-sans-serif, system-ui, sans-serif;
        --sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 var(--sans); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      a { color: inherit; }
      code { font-family: var(--mono); font-size: 0.88em; }
      img, svg { max-width: 100%; }
      :focus-visible { outline: 2px solid #a5b4fc; outline-offset: 3px; border-radius: 6px; }
      .wrap { width: min(1160px, 100% - 40px); margin-inline: auto; }
      .skip { position: absolute; left: -999px; }
      .skip:focus { left: 16px; top: 16px; z-index: 99; background: #fff; color: #000; padding: 8px 12px; border-radius: 8px; }

      /* Nav */
      .nav { position: sticky; top: 0; z-index: 20; padding-top: env(safe-area-inset-top, 0px); backdrop-filter: blur(14px) saturate(140%); background: rgba(7, 8, 13, 0.72); border-bottom: 1px solid var(--line); }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .brand { display: flex; align-items: center; gap: 10px; font: 700 18px var(--display); text-decoration: none; letter-spacing: -0.01em; }
      .brand img { border-radius: 8px; display: block; }
      .brand .dim { color: var(--muted); font-weight: 500; }
      .nav nav { display: flex; align-items: center; gap: 4px; }
      .nav nav a { text-decoration: none; color: var(--muted); padding: 8px 12px; border-radius: 10px; font-weight: 500; font-size: 15px; transition: color 0.2s, background 0.2s; }
      .nav nav a:hover { color: var(--text); background: var(--panel-2); }
      .nav .gh { display: inline-flex; align-items: center; gap: 8px; color: var(--text) !important; border: 1px solid var(--line); }

      /* Hero */
      .hero { position: relative; overflow: hidden; padding: 110px 0 70px; isolation: isolate; text-align: center; }
      .hero::before {
        content: ""; position: absolute; inset: -20% -10% auto; height: 130%; z-index: -2;
        background:
          radial-gradient(30% 45% at 12% 25%, rgba(249, 115, 22, 0.16), transparent 70%),
          radial-gradient(30% 45% at 38% 10%, rgba(79, 70, 229, 0.2), transparent 70%),
          radial-gradient(30% 45% at 66% 15%, rgba(16, 185, 129, 0.15), transparent 70%),
          radial-gradient(30% 45% at 90% 30%, rgba(14, 165, 233, 0.18), transparent 70%);
      }
      .hero::after {
        content: ""; position: absolute; inset: 0; z-index: -1;
        background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 56px 56px; mask-image: radial-gradient(60% 60% at 50% 40%, #000 30%, transparent 80%); opacity: 0.35;
      }
      .eyebrow { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 24px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); color: var(--muted); font-size: 13.5px; font-weight: 500; }
      .eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.18); }
      h1, h2, h3 { font-family: var(--display); letter-spacing: -0.025em; line-height: 1.08; margin: 0; }
      h1 { font-size: clamp(42px, 7vw, 84px); font-weight: 700; }
      .rotator { display: grid; justify-items: center; }
      .rotator .word {
        grid-area: 1 / 1; white-space: nowrap;
        background: linear-gradient(100deg, var(--a), var(--b) 50%, var(--c)); -webkit-background-clip: text; background-clip: text; color: transparent;
        opacity: 0; transform: translateY(0.35em); transition: opacity 0.5s ease, transform 0.5s ease;
      }
      .rotator .word.on { opacity: 1; transform: none; }
      .lede { font-size: clamp(17px, 1.7vw, 20px); color: #c9cdd9; max-width: 40em; margin: 26px auto 34px; }
      .cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; font-weight: 600; text-decoration: none; transition: transform 0.15s, box-shadow 0.2s, background 0.2s; }
      .btn:hover { transform: translateY(-1px); }
      .btn.primary { background: linear-gradient(135deg, #ea580c, #4f46e5 40%, #0ea5e9 70%, #10b981); color: #fff; box-shadow: 0 8px 30px -8px rgba(79, 70, 229, 0.7); }
      .btn.ghost { border: 1px solid var(--line); background: var(--panel); }
      .btn.ghost:hover { background: var(--panel-2); }

      /* Stats */
      .stats { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
      .stats div { padding: 26px 20px; text-align: center; }
      .stats div + div { border-left: 1px solid var(--line); }
      .stats strong { display: block; font: 700 clamp(30px, 4vw, 42px) / 1 var(--display); background: linear-gradient(180deg, #fff, #a5b4fc); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .stats span { color: var(--muted); font-size: 14px; }

      /* Sections */
      .section { padding: 100px 0 0; }
      .section-head { text-align: center; max-width: 720px; margin: 0 auto 44px; }
      .kicker { margin: 0 0 12px; font: 600 13px var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: #a5b4fc; }
      h2 { font-size: clamp(32px, 4.2vw, 48px); font-weight: 700; }
      .section-head p:not(.kicker) { color: var(--muted); font-size: 18px; margin: 18px 0 0; }

      /* Server cards */
      .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
      .card {
        position: relative; display: flex; flex-direction: column; padding: 28px; border-radius: 22px; overflow: hidden;
        border: 1px solid var(--line); background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.02));
        transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
      }
      .card::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, var(--a), var(--b), var(--c)); }
      .card::after { content: ""; position: absolute; inset: -40% -20% auto auto; width: 60%; height: 80%; background: radial-gradient(closest-side, var(--b), transparent); opacity: 0.1; pointer-events: none; }
      .card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--b) 45%, transparent); box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--b) 60%, transparent); }
      .card-top { display: flex; align-items: center; gap: 16px; }
      .logo { border-radius: 14px; flex: none; box-shadow: 0 10px 24px -10px var(--b); }
      .card h3 { font-size: 22px; }
      .card h3 a { text-decoration: none; }
      .card h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
      .product { margin: 2px 0 0; color: var(--muted); font-size: 14px; }
      .category { margin-left: auto; align-self: flex-start; font: 600 12px var(--mono); padding: 4px 10px; border-radius: 999px; color: var(--text); border: 1px solid color-mix(in srgb, var(--b) 50%, transparent); background: color-mix(in srgb, var(--b) 14%, transparent); }
      .talk { font: 700 clamp(24px, 2.6vw, 30px) / 1.15 var(--display); letter-spacing: -0.02em; margin: 24px 0 8px; }
      .grad { background: linear-gradient(100deg, var(--a), var(--b) 50%, var(--c)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .summary { color: #c9cdd9; margin: 0; }
      blockquote { margin: 18px 0 0; padding: 12px 16px; border-radius: 12px; font-size: 15px; color: var(--text); background: rgba(0, 0, 0, 0.25); border-left: 3px solid var(--b); }
      .facts { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
      .facts li { font-size: 13.5px; color: var(--muted); padding: 5px 11px; border-radius: 999px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.03); }
      .facts strong { color: var(--text); font-weight: 600; }
      .facts a { text-decoration: none; }
      .facts a:hover strong { text-decoration: underline; }
      .pull { display: flex; align-items: center; gap: 12px; margin-top: 18px; padding: 8px 8px 8px 14px; border-radius: 12px; border: 1px solid var(--line); background: rgba(0, 0, 0, 0.35); }
      .pull code { min-width: 0; flex: 1; color: #dbe0ee; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; }
      .pull code::before { content: "$ "; color: var(--muted); }
      .copy { flex: none; cursor: pointer; font: 500 12.5px var(--sans); color: var(--text); padding: 6px 11px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel-2); }
      .copy:hover { background: rgba(255, 255, 255, 0.12); }
      .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 20px; }
      .btn.small { padding: 9px 14px; font-size: 14px; border-radius: 10px; }
      .card .btn.primary { background: linear-gradient(135deg, var(--a), var(--b) 60%, var(--c)); box-shadow: 0 8px 24px -10px var(--b); }

      /* Principles */
      .principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
      .principle { padding: 24px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--panel); }
      .p-icon { font-size: 24px; }
      .principle h3 { font-size: 19px; margin: 12px 0 8px; }
      .principle p { margin: 0; color: var(--muted); font-size: 15px; }
      .connect { display: grid; grid-template-columns: 1fr 1.1fr; gap: 32px; align-items: center; margin-top: 20px; padding: 32px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--panel); }
      .connect h3 { font-size: 24px; margin-bottom: 10px; }
      .connect p { color: var(--muted); margin: 0; }
      .connect p code { color: #dbe0ee; }
      .code { position: relative; border-radius: 12px; background: #040509; border: 1px solid var(--line); min-width: 0; }
      .code .copy { position: absolute; top: 8px; right: 8px; }
      .code pre { margin: 0; padding: 16px; padding-top: 40px; overflow-x: auto; font-size: 13px; line-height: 1.7; color: #dbe0ee; }

      /* Footer */
      .footer { margin-top: 110px; border-top: 1px solid var(--line); padding: 36px 0 calc(36px + env(safe-area-inset-bottom, 0px)); background: var(--bg-2); }
      .foot-inner { display: grid; gap: 14px; }
      .foot-links { display: flex; flex-wrap: wrap; gap: 6px 22px; }
      .foot-links a { color: var(--text); text-decoration: none; font-size: 14.5px; }
      .foot-links a:hover { color: #a5b4fc; }
      .footer p { margin: 0; color: var(--muted); font-size: 13px; max-width: 70em; }

      @media (max-width: 960px) {
        .cards { grid-template-columns: minmax(0, 1fr); }
        .principles { grid-template-columns: repeat(2, 1fr); }
        .connect { grid-template-columns: minmax(0, 1fr); }
      }
      @media (max-width: 640px) {
        .wrap { width: calc(100% - 32px); }
        .hide-sm { display: none; }
        .hero { padding-top: 72px; }
        .stats { grid-template-columns: repeat(2, 1fr); }
        .stats div:nth-child(3) { border-left: none; }
        .stats div:nth-child(n + 3) { border-top: 1px solid var(--line); }
        .principles { grid-template-columns: minmax(0, 1fr); }
        .card, .connect { padding: 22px; }
        .section { padding-top: 76px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }
    </style>
  </body>
</html>
