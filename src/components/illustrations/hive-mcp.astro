---
// Hive: a thermostat dial beside a radiator giving off heat.
import Spot from "./Spot.astro";
import type { IllustrationProps } from "./types";
type Props = IllustrationProps;
const { id, colors, variant = "spot" } = Astro.props;
const g = `sp-${id}`;
---

{
  variant === "glyph" ? (
    <g>
      <circle cx="32" cy="32" r="17" fill="none" stroke="#ffffff" stroke-width="4" stroke-dasharray="80 30" stroke-linecap="round" />
      <text x="32" y="37" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="13" fill="#ffffff">
        21°
      </text>
    </g>
  ) : (
    <Spot>
      <defs>
        <linearGradient id={g} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={colors[0]} />
          <stop offset="1" stop-color={colors[2]} />
        </linearGradient>
      </defs>
      <circle cx="110" cy="66" r="46" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="10" />
      <circle
        cx="110"
        cy="66"
        r="46"
        fill="none"
        stroke={`url(#${g})`}
        stroke-width="10"
        stroke-dasharray="200 90"
        stroke-linecap="round"
        transform="rotate(130 110 66)"
      />
      <text x="110" y="74" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="26" fill="#eceef4">
        21°
      </text>
      <g fill={`url(#${g})`}>
        <rect x="200" y="36" width="12" height="70" rx="6" />
        <rect x="220" y="36" width="12" height="70" rx="6" />
        <rect x="240" y="36" width="12" height="70" rx="6" />
        <rect x="260" y="36" width="12" height="70" rx="6" />
        <rect x="280" y="36" width="12" height="70" rx="6" />
      </g>
      <g fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2.5" stroke-linecap="round">
        <path d="M214 28 q-6 -8 0 -16" />
        <path d="M246 28 q-6 -8 0 -16" />
        <path d="M278 28 q-6 -8 0 -16" />
      </g>
    </Spot>
  )
}
