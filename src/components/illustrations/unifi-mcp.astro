---
// UniFi: an access point broadcasting Wi-Fi to client devices.
import Spot from "./Spot.astro";
import type { IllustrationProps } from "./types";
type Props = IllustrationProps;
const { id, colors, variant = "spot" } = Astro.props;
const g = `sp-${id}`;
---

{
  variant === "glyph" ? (
    <g>
      <g fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round">
        <path d="M18 32 a14 14 0 0 1 28 0" />
        <path d="M11 26 a22 22 0 0 1 42 0" opacity="0.7" />
      </g>
      <circle cx="32" cy="38" r="5" fill="#ffffff" />
    </g>
  ) : (
    <Spot>
      <defs>
        <linearGradient id={g} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={colors[0]} />
          <stop offset="1" stop-color={colors[2]} />
        </linearGradient>
      </defs>
      <g stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-dasharray="3 4">
        <line x1="180" y1="52" x2="70" y2="104" />
        <line x1="180" y1="52" x2="130" y2="114" />
        <line x1="180" y1="52" x2="230" y2="114" />
        <line x1="180" y1="52" x2="290" y2="104" />
      </g>
      <ellipse cx="180" cy="40" rx="34" ry="12" fill={`url(#${g})`} />
      <g fill="none" stroke={`url(#${g})`} stroke-width="2.5" stroke-linecap="round">
        <path d="M140 66 a40 22 0 0 0 80 0" />
        <path d="M118 74 a62 34 0 0 0 124 0" opacity="0.7" />
        <path d="M96 82 a84 46 0 0 0 168 0" opacity="0.45" />
      </g>
      <g fill="#ffffff">
        <circle cx="70" cy="104" r="6" />
        <circle cx="130" cy="114" r="6" />
        <circle cx="230" cy="114" r="6" />
        <circle cx="290" cy="104" r="6" />
      </g>
    </Spot>
  )
}
