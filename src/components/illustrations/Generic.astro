---
// Fallback for a server without its own illustration: a stack of rounded tiles in its gradient.
import Spot from "./Spot.astro";
import type { IllustrationProps } from "./types";
type Props = IllustrationProps;
const { id, colors, variant = "spot" } = Astro.props;
const g = `sp-${id}`;
---

{
  variant === "glyph" ? (
    <g fill="#ffffff">
      <rect x="14" y="14" width="16" height="16" rx="4" />
      <rect x="34" y="14" width="16" height="16" rx="4" opacity="0.8" />
      <rect x="14" y="34" width="16" height="16" rx="4" opacity="0.8" />
      <rect x="34" y="34" width="16" height="16" rx="4" />
    </g>
  ) : (
    <Spot>
      <defs>
        <linearGradient id={g} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={colors[0]} />
          <stop offset="1" stop-color={colors[2]} />
        </linearGradient>
      </defs>
      <rect x="150" y="18" width="120" height="70" rx="16" fill={`url(#${g})`} opacity="0.35" />
      <rect x="120" y="30" width="120" height="70" rx="16" fill={`url(#${g})`} opacity="0.6" />
      <rect x="90" y="42" width="120" height="70" rx="16" fill={`url(#${g})`} />
      <g fill="#ffffff">
        <circle cx="112" cy="64" r="5" />
        <rect x="126" y="60" width="64" height="8" rx="4" opacity="0.7" />
        <rect x="108" y="84" width="82" height="8" rx="4" opacity="0.45" />
      </g>
    </Spot>
  )
}
